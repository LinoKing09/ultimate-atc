{
  "name": "ultimate-atc",
  "version": "0.4.0",
  "private": true,
  "description": "A browser-based air traffic control simulator inspired by EuroScope and VATSIM.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "soak": "vitest run tests/soak.test.ts --silent=false",
    "benchmark": "vitest run tests/benchmark.test.ts --silent=false"
  },
  "devDependencies": {
    "typescript": "~5.9",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
